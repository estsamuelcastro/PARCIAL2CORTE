<?xml version="1.0"?>
<robot name="fabrica_monedas_inteligentes_v1">

  <!--
    Versión corregida y ampliada a partir de maqueta.urdf.
    Conserva la idea original de fábrica en L, clasificación, brazos y carro,
    pero añade colisiones, joints móviles, cinco vasos, electrónica representada,
    tres obstáculos, meta y un carro móvil con ruedas.
    Las monedas dinámicas se generan desde PyBullet como cuerpos independientes.
  -->

  <!-- ======================== MATERIALES ======================== -->
  <material name="blue_metal"><color rgba="0.05 0.15 0.35 1"/></material>
  <material name="black_rubber"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="white_machine"><color rgba="0.95 0.95 0.98 1"/></material>
  <material name="base_material"><color rgba="0.30 0.30 0.30 1"/></material>
  <material name="brazo1_material"><color rgba="0.20 0.60 0.80 1"/></material>
  <material name="brazo2_material"><color rgba="0.90 0.50 0.10 1"/></material>
  <material name="pinza_material"><color rgba="0.80 0.20 0.20 1"/></material>
  <material name="dedo_material"><color rgba="0.90 0.90 0.90 1"/></material>
  <material name="carro_material"><color rgba="0.10 0.30 0.60 1"/></material>
  <material name="coin10_material"><color rgba="0.72 0.72 0.76 1"/></material>
  <material name="coin20_material"><color rgba="0.78 0.62 0.24 1"/></material>
  <material name="coin50_material"><color rgba="0.82 0.50 0.14 1"/></material>
  <material name="coin1_material"><color rgba="0.88 0.72 0.20 1"/></material>
  <material name="coin2_material"><color rgba="0.72 0.56 0.18 1"/></material>
  <material name="obstacle_material"><color rgba="0.55 0.15 0.10 1"/></material>
  <material name="goal_material"><color rgba="0.10 0.75 0.25 1"/></material>
  <material name="camera_material"><color rgba="0.06 0.06 0.06 1"/></material>
  <material name="led_material"><color rgba="1.0 0.85 0.10 1"/></material>
  <material name="lcd_material"><color rgba="0.05 0.20 0.20 1"/></material>

  <!-- Raíz estática; representa el piso/base de la planta -->
  <link name="base_planta">
    <visual><origin xyz="0 0 -0.05" rpy="0 0 0"/><geometry><box size="16.0 12.0 0.1"/></geometry><material name="base_material"/></visual>
    <collision><origin xyz="0 0 -0.05" rpy="0 0 0"/><geometry><box size="12.0 10.0 0.1"/></geometry></collision>
  </link>
  <!-- Cinta superior: de la máquina hacia la derecha -->
  <link name="cinta_seg1">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="4.0 0.5 0.1"/></geometry><material name="blue_metal"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="4.0 0.5 0.1"/></geometry></collision>
  </link>
  <joint name="j_cinta_seg1" type="fixed">
    <parent link="base_planta"/>
    <child link="cinta_seg1"/>
    <origin xyz="1.0 0.0 0.5" rpy="0 0 0"/>
  </joint>
  <link name="cinta_seg1_superficie">
    <visual><origin xyz="0 0 0.08" rpy="0 0 0"/><geometry><box size="3.85 0.46 0.06"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0.08" rpy="0 0 0"/><geometry><box size="3.85 0.46 0.06"/></geometry></collision>
  </link>
  <joint name="j_cinta_seg1_surface" type="fixed">
    <parent link="cinta_seg1"/>
    <child link="cinta_seg1_superficie"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="rodillo_s1_1">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry></collision>
    <inertial>
      <mass value="0.600000"/>
      <inertia ixx="0.014420" ixy="0" ixz="0" iyy="0.014420" iyz="0" izz="0.007680"/>
    </inertial>
  </link>
  <joint name="j_rodillo_s1_1" type="continuous">
    <parent link="cinta_seg1"/>
    <child link="rodillo_s1_1"/>
    <origin xyz="-1.82 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="4" velocity="30"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <link name="rodillo_s1_2">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry></collision>
    <inertial>
      <mass value="0.600000"/>
      <inertia ixx="0.014420" ixy="0" ixz="0" iyy="0.014420" iyz="0" izz="0.007680"/>
    </inertial>
  </link>
  <joint name="j_rodillo_s1_2" type="continuous">
    <parent link="cinta_seg1"/>
    <child link="rodillo_s1_2"/>
    <origin xyz="1.82 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="4" velocity="30"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <!-- Cinta vertical: descenso por el lado izquierdo -->
  <link name="cinta_seg2">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="4.0 0.5 0.1"/></geometry><material name="blue_metal"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="4.0 0.5 0.1"/></geometry></collision>
  </link>
  <joint name="j_cinta_seg2" type="fixed">
    <parent link="base_planta"/>
    <child link="cinta_seg2"/>
    <origin xyz="-1.0 -2.0 0.5" rpy="0 0 1.5708"/>
  </joint>
  <link name="cinta_seg2_superficie">
    <visual><origin xyz="0 0 0.08" rpy="0 0 0"/><geometry><box size="3.85 0.46 0.06"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0.08" rpy="0 0 0"/><geometry><box size="3.85 0.46 0.06"/></geometry></collision>
  </link>
  <joint name="j_cinta_seg2_surface" type="fixed">
    <parent link="cinta_seg2"/>
    <child link="cinta_seg2_superficie"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="rodillo_s2_1">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry></collision>
    <inertial>
      <mass value="0.600000"/>
      <inertia ixx="0.014420" ixy="0" ixz="0" iyy="0.014420" iyz="0" izz="0.007680"/>
    </inertial>
  </link>
  <joint name="j_rodillo_s2_1" type="continuous">
    <parent link="cinta_seg2"/>
    <child link="rodillo_s2_1"/>
    <origin xyz="-1.82 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="4" velocity="30"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <link name="rodillo_s2_2">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry></collision>
    <inertial>
      <mass value="0.600000"/>
      <inertia ixx="0.014420" ixy="0" ixz="0" iyy="0.014420" iyz="0" izz="0.007680"/>
    </inertial>
  </link>
  <joint name="j_rodillo_s2_2" type="continuous">
    <parent link="cinta_seg2"/>
    <child link="rodillo_s2_2"/>
    <origin xyz="1.82 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="4" velocity="30"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <!-- Cinta inferior: salida hacia la derecha -->
  <link name="cinta_seg3">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="4.0 0.5 0.1"/></geometry><material name="blue_metal"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="4.0 0.5 0.1"/></geometry></collision>
  </link>
  <joint name="j_cinta_seg3" type="fixed">
    <parent link="base_planta"/>
    <child link="cinta_seg3"/>
    <origin xyz="1.0 -4.0 0.5" rpy="0 0 0"/>
  </joint>
  <link name="cinta_seg3_superficie">
    <visual><origin xyz="0 0 0.08" rpy="0 0 0"/><geometry><box size="3.85 0.46 0.06"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0.08" rpy="0 0 0"/><geometry><box size="3.85 0.46 0.06"/></geometry></collision>
  </link>
  <joint name="j_cinta_seg3_surface" type="fixed">
    <parent link="cinta_seg3"/>
    <child link="cinta_seg3_superficie"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="rodillo_s3_1">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry></collision>
    <inertial>
      <mass value="0.600000"/>
      <inertia ixx="0.014420" ixy="0" ixz="0" iyy="0.014420" iyz="0" izz="0.007680"/>
    </inertial>
  </link>
  <joint name="j_rodillo_s3_1" type="continuous">
    <parent link="cinta_seg3"/>
    <child link="rodillo_s3_1"/>
    <origin xyz="-1.82 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="4" velocity="30"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <link name="rodillo_s3_2">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry><material name="black_rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.46"/></geometry></collision>
    <inertial>
      <mass value="0.600000"/>
      <inertia ixx="0.014420" ixy="0" ixz="0" iyy="0.014420" iyz="0" izz="0.007680"/>
    </inertial>
  </link>
  <joint name="j_rodillo_s3_2" type="continuous">
    <parent link="cinta_seg3"/>
    <child link="rodillo_s3_2"/>
    <origin xyz="1.82 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="4" velocity="30"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>
  <!-- Base de la máquina de alimentación/visión -->
  <link name="maquina_embalaje_base">
    <visual><origin xyz="0 0 0.0" rpy="0 0 0"/><geometry><box size="2.0 1.2 0.2"/></geometry><material name="blue_metal"/></visual>
    <collision><origin xyz="0 0 0.0" rpy="0 0 0"/><geometry><box size="2.0 1.2 0.2"/></geometry></collision>
    <inertial>
      <mass value="20.000000"/>
      <inertia ixx="2.466667" ixy="0" ixz="0" iyy="6.733333" iyz="0" izz="9.066667"/>
    </inertial>
  </link>
  <joint name="j_maquina_base" type="fixed">
    <parent link="base_planta"/>
    <child link="maquina_embalaje_base"/>
    <origin xyz="-3.0 0.0 0.1" rpy="0 0 0"/>
  </joint>
  <link name="maquina_embalaje_cuerpo">
    <visual><origin xyz="0 0 0.75" rpy="0 0 0"/><geometry><box size="1.8 1.2 1.5"/></geometry><material name="white_machine"/></visual>
    <collision><origin xyz="0 0 0.75" rpy="0 0 0"/><geometry><box size="1.8 1.2 1.5"/></geometry></collision>
    <inertial>
      <mass value="80.000000"/>
      <inertia ixx="24.600000" ixy="0" ixz="0" iyy="36.600000" iyz="0" izz="31.200000"/>
    </inertial>
  </link>
  <joint name="j_maquina_cuerpo" type="fixed">
    <parent link="maquina_embalaje_base"/>
    <child link="maquina_embalaje_cuerpo"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  <!-- Tolva visual simplificada; las monedas se generan como cuerpos independientes en PyBullet -->
  <link name="tolva_vision">
    <visual><origin xyz="0 0 0.325" rpy="0 0 0"/><geometry><box size="0.9 1.0 0.65"/></geometry><material name="white_machine"/></visual>
    <collision><origin xyz="0 0 0.325" rpy="0 0 0"/><geometry><box size="0.9 1.0 0.65"/></geometry></collision>
    <inertial>
      <mass value="8.000000"/>
      <inertia ixx="0.948333" ixy="0" ixz="0" iyy="0.821667" iyz="0" izz="1.206667"/>
    </inertial>
  </link>
  <joint name="j_tolva_vision" type="fixed">
    <parent link="base_planta"/>
    <child link="tolva_vision"/>
    <origin xyz="-4.0 0.0 1.5" rpy="0 0 -0.18"/>
  </joint>
  <link name="vision_mount">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.3 0.3 0.45"/></geometry><material name="camera_material"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.3 0.3 0.45"/></geometry></collision>
    <inertial>
      <mass value="1.000000"/>
      <inertia ixx="0.024375" ixy="0" ixz="0" iyy="0.024375" iyz="0" izz="0.015000"/>
    </inertial>
  </link>
  <joint name="j_vision_mount" type="fixed">
    <parent link="maquina_embalaje_cuerpo"/>
    <child link="vision_mount"/>
    <origin xyz="-1.1 -0.58 1.2" rpy="0 0 0"/>
  </joint>
  <link name="esp32_cam_module">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.16 0.1 0.1"/></geometry><material name="camera_material"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.16 0.1 0.1"/></geometry></collision>
    <inertial>
      <mass value="0.100000"/>
      <inertia ixx="0.000167" ixy="0" ixz="0" iyy="0.000297" iyz="0" izz="0.000297"/>
    </inertial>
  </link>
  <joint name="j_esp32_cam" type="fixed">
    <parent link="vision_mount"/>
    <child link="esp32_cam_module"/>
    <origin xyz="0.18 0 0.1" rpy="0 0 0"/>
  </joint>
  <link name="led_vision">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.02"/></geometry><material name="led_material"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.02"/></geometry></collision>
    <inertial>
      <mass value="0.020000"/>
      <inertia ixx="0.000007" ixy="0" ixz="0" iyy="0.000007" iyz="0" izz="0.000012"/>
    </inertial>
  </link>
  <joint name="j_led_vision" type="fixed">
    <parent link="esp32_cam_module"/>
    <child link="led_vision"/>
    <origin xyz="0.1 -0.055 0" rpy="0 0 0"/>
  </joint>
  <link name="lcd_display">
