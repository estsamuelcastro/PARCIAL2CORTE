  </link>
  <joint name="j_lcd_display" type="fixed">
    <parent link="maquina_embalaje_cuerpo"/>
    <child link="lcd_display"/>
    <origin xyz="0 -0.65 0.95" rpy="0 0 0"/>
  </joint>
  <link name="soporte_vaso_50">
